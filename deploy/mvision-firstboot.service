[Unit]
Description=MVision - Provisionamento do primeiro boot (imagem dourada)
After=local-fs.target
Before=hospital-monitor.service mvision-web.service
ConditionPathExists=!/var/lib/mvision-firstboot-done

[Service]
Type=oneshot
ExecStart=/usr/local/bin/mvision-firstboot
RemainAfterExit=yes
# Reparticionamento + resize2fs + (opcional) rebuild do initramfs do overlay
# podem passar de 5 minutos num SD lento
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
